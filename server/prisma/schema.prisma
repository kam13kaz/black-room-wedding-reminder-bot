generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  fullName  String
  phone     String    @unique
  email     String?
  weddings  Wedding[]
  createdAt DateTime  @default(now())
}

model Wedding {
  id          String     @id @default(cuid())
  title       String
  groomName   String
  brideName   String
  weddingDate DateTime
  venue        String
  ownerId      String
  owner        User       @relation(fields: [ownerId], references: [id])
  guests       Guest[]
  reminders    Reminder[]
  createdAt    DateTime   @default(now())
}

model Guest {
  id          String    @id @default(cuid())
  fullName    String
  phone       String
  rsvpStatus  String     @default("Pending")
  weddingId   String
  wedding     Wedding    @relation(fields: [weddingId], references: [id])
}

model Reminder {
  id          String    @id @default(cuid())
  message     String
  sendAt      DateTime
  sent        Boolean   @default(false)
  weddingId   String
  wedding     Wedding   @relation(fields: [weddingId], references: [id])
  createdAt   DateTime  @default(now())
}